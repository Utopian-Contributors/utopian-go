{
  "name": "utopian-go",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:og": "node scripts/og-image.mjs",
    "build:icons": "node scripts/app-icons.mjs",
    "build:skeu": "node scripts/skeu-icons.mjs && node scripts/app-icons.mjs",
    "build:scene": "node scripts/home-scene.mjs",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production node dist/server.js",
    "size": "node scripts/build-client.mjs",
    "test": "npm run build:server && node --test dist/social/social.test.js",
    "seed": "npm run build:server && node --env-file=.env dist/social/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.12",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.33.0",
    "railway": "^3.16.0",
    "skeu-icons": "0.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
