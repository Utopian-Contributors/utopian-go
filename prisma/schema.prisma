generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  name         String    @id
  uid          String    @unique
  passSalt     String    @map("pass_salt")
  passHash     String    @map("pass_hash")
  phraseSalt   String    @map("phrase_salt")
  phraseIv     String    @map("phrase_iv")
  phraseTag    String    @map("phrase_tag")
  phraseCt     String    @map("phrase_ct")
  address      String    @unique(map: "users_address")
  bio          String    @default("")
  loc          String    @default("")
  avatarRev    Int       @default(0) @map("avatar_rev")
  lastPost     BigInt    @default(0) @map("last_post")
  created      BigInt
  passkeyId    String?   @unique(map: "users_passkey") @map("passkey_id")
  passkeyCose  String?   @map("passkey_cose")
  passkeyAlg   Int?      @map("passkey_alg")
  passkeyCount Int?      @map("passkey_count")
  /// Session counter. A cookie signed under another value is refused.
  epoch        Int       @default(0)
  /// Proof of acceptance: the Terms of Service version agreed to at sign-up, and when.
  termsVersion String?   @map("terms_version")
  termsAt      BigInt?   @map("terms_at")
  posts        Post[]
  comments     Comment[]
  saves        Save[]
  friends      Friend[]  @relation("owner")
  friendOf     Friend[]  @relation("friend")
  notes        Note[]    @relation("to")
  notesSent    Note[]    @relation("from")

  @@map("users")
}

model Friend {
  owner      String
  friend     String
  ownerUser  User   @relation("owner", fields: [owner], references: [name], onDelete: Cascade, onUpdate: NoAction)
  friendUser User   @relation("friend", fields: [friend], references: [name], onDelete: Cascade, onUpdate: NoAction)

  @@id([owner, friend])
  @@map("friends")
}

model Post {
  id       String    @id
  byName   String    @map("by_name")
  text     String
  at       BigInt
  views    Int       @default(0)
  /// Pictures on the post. A re-post carries its original's count; the files stay under the original's id.
  photos   Int       @default(0)
  /// A voice memo's length in milliseconds; 0 when the post has none. A re-post carries its original's.
  audio    Int       @default(0)
  /// The memo's shape, one base64url character per bar.
  wave     String    @default("")
  repost   String?
  author   User      @relation(fields: [byName], references: [name], onDelete: NoAction, onUpdate: NoAction)
  original Post?     @relation("repost", fields: [repost], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reposts  Post[]    @relation("repost")
  comments Comment[]
  saves    Save[]

  /// One re-post per person per post, which also answers "did I re-post this".
  @@unique([repost, byName], map: "posts_repost", where: raw("(repost IS NOT NULL)"))
  @@index([at(sort: Desc), id(sort: Desc)], map: "posts_at_id")
  /// The timeline with images or audio left out, or both.
  @@index([at(sort: Desc), id(sort: Desc)], map: "posts_at_id_no_photos", where: raw("(photos = 0)"))
  @@index([at(sort: Desc), id(sort: Desc)], map: "posts_at_id_no_audio", where: raw("(audio = 0)"))
  @@index([at(sort: Desc), id(sort: Desc)], map: "posts_at_id_plain", where: raw("((photos = 0) AND (audio = 0))"))
  /// A profile, and each author's page of the Friends timeline.
  @@index([byName, at(sort: Desc), id(sort: Desc)], map: "posts_by_at_id")
  @@map("posts")
}

model Comment {
  id     String @id
  postId String @map("post")
  byName String @map("by_name")
  text   String
  at     BigInt
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author User   @relation(fields: [byName], references: [name], onDelete: NoAction, onUpdate: NoAction)

  @@index([postId], map: "comments_post")
  @@map("comments")
}

/// Newest 100 per person; older ones are dropped as new ones arrive.
model Note {
  id       String  @id
  toName   String  @map("to_name")
  fromName String  @map("from_name")
  post     String
  at       BigInt
  seen     Boolean @default(false)
  kind     String  @default("comment")
  to       User    @relation("to", fields: [toName], references: [name], onDelete: Cascade, onUpdate: NoAction)
  from     User    @relation("from", fields: [fromName], references: [name], onDelete: NoAction, onUpdate: NoAction)

  @@index([toName, seen], map: "notes_to")
  @@index([toName, at(sort: Desc)], map: "notes_to_at")
  @@map("notes")
}

model Save {
  postId String @map("post")
  byName String @map("by_name")
  at     BigInt
  /// The saved post's own time, so Saved pages through saves in the timeline's order.
  postAt BigInt @map("post_at")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User   @relation(fields: [byName], references: [name], onDelete: Cascade, onUpdate: NoAction)

  @@id([postId, byName])
  @@index([byName, postAt(sort: Desc), postId(sort: Desc)], map: "saves_by_post")
  @@map("saves")
}
