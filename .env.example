# Brave Search — web, news, video, discussion and image results.
BRAVE_API_KEY=

# Helius RPC (DAS-enabled) — live price refresh for the Solana token index, and
# the wallet balance lookups behind the buy dialog.
# A plain Solana RPC cannot answer price queries; Helius layers price_info onto
# getAsset, which is what makes this work.
# Prices still work without it (they refresh hourly from Jupiter rather than on
# demand) but /api/balances cannot, so the buy dialog reports every balance as
# unknown and stops telling anyone they cannot afford a trade. Set it in any
# environment where people can actually swap.
# https://dashboard.helius.dev
HELIUS_RPC_URL=

# —— Social accounts: required in production ——
#
# 32 random bytes, base64url. Seals each account's server copy of its phrase
# (AES-256-GCM) so the server can sign swaps and sends. Kept out of Postgres on
# purpose: a copy of the database opens no key.
# Production refuses to register or log anyone in without it. Outside production
# it falls back to a generated key file in the social data dir.
# Set it once and never rotate or lose it: every sealed key_* column becomes
# unreadable, and every session cookie is refused, unless SOCIAL_SECRET is set.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WALLET_KEY=

# Optional. Signs session cookies. Unset derives it from WALLET_KEY.
# SOCIAL_SECRET=

# Optional
# PORT=3000

# Public origin — absolutises the og:image URL so social crawlers can fetch
# the card. Unset falls back to the canonical origin in src/config.ts; set it
# only on a staging host that should advertise its own card.
SITE_URL=https://utopiango.com

# —— Swap referral: this is where the revenue comes from ——
#
# Referral *token* accounts from https://referral.jup.ag — each is a PDA of
# ["referral_ata", referralAccount, mint] under REFER4Zg…, created once from the
# dashboard. Jupiter charges the fee on whichever side of the trade matches the
# account it is handed, so one account per quote token covers the whole index.
#
# Leave either empty to disable fees on that side; swaps still work, they are
# just unattributed. An environment provisioned without these trades fine and
# earns nothing, which is silent — so treat them as required in production.
JUP_FEE_ACCOUNT_SOL=
JUP_FEE_ACCOUNT_USDC=

# Integrator fee in basis points, charged to the user on each swap. Bounded at
# 100 (1%) in code. Unset means 20. An explicit 0 is honoured and turns the fee
# off — see JUP_FEE_BPS in src/config.ts.
# JUP_FEE_BPS=20

# —— Advertise ——
#
# The Solana wallet that advertisers pay, in USDC or SOL, by Solana Pay.
# Payments are confirmed by watching for each order's reference through
# HELIUS_RPC_URL, so both must be set for checkout to work. Unset, ads can be drafted and
# previewed, and checkout answers that payments are not set up.
ADS_PAY_TO=
