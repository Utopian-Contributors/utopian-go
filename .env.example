# Brave Search — web, news, video, discussion and image results.
BRAVE_API_KEY=

# Helius RPC (DAS-enabled) — live price refresh for the Solana token index.
# A plain Solana RPC cannot answer price queries; Helius layers price_info onto
# getAsset, which is what makes this work. Optional: without it the index still
# serves prices, they just refresh hourly instead of on demand.
# https://dashboard.helius.dev
HELIUS_RPC_URL=

# Optional
# PORT=3000
